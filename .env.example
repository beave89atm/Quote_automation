# KANNON_DATA_DIR=

# SecturaFAB REST API (per support guidance)
# Get client id/secret from: https://secturafab.com/apikey
SECTURAFAB_BASE_URL=https://api.secturafab.com
SECTURAFAB_TOKEN_URL=https://www.secturafab.com/token
SECTURAFAB_CLIENT_ID=
SECTURAFAB_CLIENT_SECRET=

# Website MVC Finish (Image Files / Long). Cookie header or path to a file
# whose first line is the Cookie header, from the signed-in box Chrome.
# Never commit a real value. No paste-cookie UX. Fail closed if missing.
# Do not unwrap Windows Chrome. Do not use Kyle's quoting PC.
# SECTURAFAB_WEBSITE_URL=https://www.secturafab.com
# SECTURA_WEBSITE_COOKIE=
# SECTURAFAB_WEBSITE_COOKIE=

# Defaults used when classifying CAD Files / Image Files Finish
SECTURAFAB_DEFAULT_MACHINE=Laser
SECTURAFAB_DEFAULT_MATERIAL=A36
SECTURAFAB_DEFAULT_THICKNESS=0.25
SECTURAFAB_ORGANIZATION=Kannon Manufacturing
